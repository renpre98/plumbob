[Unit]
Description=Plumbob daemon — drives the SteelSeries Sims 4 USB Plumbob via /dev/hidraw
Documentation=https://github.com/renpre98/plumbob
# Don't even try if the device isn't plugged in.
ConditionPathExistsGlob=/sys/bus/hid/devices/*1038:1500*

[Service]
Type=simple
ExecStart=%h/.local/bin/plumbob-daemon
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=10
# Give up after 5 failed restarts in a minute, so a persistent failure can never
# spam the journal (the v1.0.0 release had a bug where the worker tight-looped
# on hidraw write errors after the device was unplugged).
StartLimitBurst=5
StartLimitIntervalSec=60
# The daemon only opens /dev/hidraw*, binds to 127.0.0.1:27301, reads from $HOME/.config.
# Nothing else needs to be writable. The defaults below harden against accidents.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=
PrivateDevices=false

[Install]
WantedBy=default.target
